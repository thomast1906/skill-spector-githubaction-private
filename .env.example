# Copy this to .env and fill in your values

SKILLSPECTOR_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Optional: override the OpenAI endpoint (e.g. Azure OpenAI / AI Foundry, Ollama, vLLM)
# OPENAI_BASE_URL=https://<your-resource-name>.openai.azure.com/openai/v1/

# Optional: override the model (use your Azure deployment name if using Azure OpenAI)
# SKILLSPECTOR_MODEL=<your-deployment-name>
